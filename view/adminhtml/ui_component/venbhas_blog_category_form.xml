<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">venbhas_blog_category_form.venbhas_blog_category_form_data_source</item>
            <item name="namespace" xsi:type="string">venbhas_blog_category_form</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Category Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Venbhas\Blog\Block\Adminhtml\Category\Edit\SaveButton"/>
            <button name="delete" class="Venbhas\Blog\Block\Adminhtml\Category\Edit\DeleteButton"/>
            <button name="back" class="Venbhas\Blog\Block\Adminhtml\Category\Edit\BackButton"/>
        </buttons>
        <namespace>venbhas_blog_category_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>venbhas_blog_category_form.venbhas_blog_category_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="venbhas_blog_category_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="blog/category/save"/>
        </settings>
        <dataProvider class="Venbhas\Blog\Model\Category\DataProvider" name="venbhas_blog_category_form_data_source">
            <settings>
                <requestFieldName>category_id</requestFieldName>
                <primaryFieldName>category_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="category_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>category_id</dataScope>
            </settings>
        </field>
        <field name="parent_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>parent_id</dataScope>
            </settings>
        </field>
        <field name="status" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/form/element/single-checkbox</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>number</dataType>
                <label translate="true">Enabled</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
            </field>
        <field name="name" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
            </settings>
        </field>  
        
    </fieldset>
    <fieldset name="content" sortOrder="15">
        <settings>

            <collapsible>true</collapsible>
            <label translate="true">Content</label>
        </settings>
        <field name="short_description" template="ui/form/field" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <!-- Force core TinyMCE WYSIWYG (avoid PageBuilder element override) -->
                    <item name="component" xsi:type="string">Magento_Ui/js/form/element/wysiwyg</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/wysiwyg</item>
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="add_variables" xsi:type="boolean">false</item>
                        <item name="add_widgets" xsi:type="boolean">false</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                        <item name="use_container" xsi:type="boolean">true</item>
                        <item name="container_class" xsi:type="string">hor-scroll</item>
                        <item name="is_pagebuilder_enabled" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Short Description</label>
                <dataScope>short_description</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="description" template="ui/form/field" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="add_variables" xsi:type="boolean">true</item>
                        <item name="add_widgets" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                        <item name="is_pagebuilder_enabled" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
            <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="featured_image" formElement="imageUploader">
            <settings>
                <label translate="true">Featured Image</label>
                <dataType>string</dataType>
                <dataScope>featured_image</dataScope>
                <elementTmpl>ui/form/element/uploader/uploader</elementTmpl>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="blog/category/upload"/>
                        </uploaderConfig>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="20">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Search Engine Optimization</label>
        </settings>
        <field name="url_key" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <dataScope>url_key</dataScope>
                <notice translate="true">Leave empty to auto-generate from name.</notice>
            </settings>
        </field>
        <field name="meta_title" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_keywords" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Keywords</label>
                <dataScope>meta_keywords</dataScope>
            </settings>
        </field>
        <field name="meta_description" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <dataScope>meta_description</dataScope>
            </settings>
        </field>
        <container name="meta_robots_group" component="Magento_Ui/js/form/components/group" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="type" xsi:type="string">group</item>
                <item name="config" xsi:type="array">
                    <item name="breakLine" xsi:type="boolean">true</item>
                </item>
            </argument>
            <field name="meta_robots" formElement="select">
                <settings>
                    <additionalClasses>
                        <class name="admin__field-default">true</class>
                    </additionalClasses>
                    <dataType>number</dataType>
                    <label translate="true">Meta Robots</label>
                    <dataScope>meta_robots</dataScope>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Venbhas\Blog\Model\Config\Source\MetaRobots"/>
                        </settings>
                    </select>
                </formElements>
            </field>
            <field name="use_config_meta_robots" formElement="checkbox">
                <settings>
                    <dataType>boolean</dataType>
                    <dataScope>use_config_meta_robots</dataScope>
                    <exports>
                        <link name="checked">ns = ${ $.ns }, index = meta_robots :disabled</link>
                    </exports>
                </settings>
                <formElements>
                    <checkbox>
                        <settings>
                            <description translate="true">Use Config Settings</description>
                            <valueMap>
                                <map name="false" xsi:type="boolean">false</map>
                                <map name="true" xsi:type="boolean">true</map>
                            </valueMap>
                        </settings>
                    </checkbox>
                </formElements>
            </field>
        </container>
    </fieldset>
</form>
