<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">venbhas_blog_listing.venbhas_blog_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Article</label>
            </button>
        </buttons>
        <spinner>venbhas_blog_columns</spinner>
        <deps>
            <dep>venbhas_blog_listing.venbhas_blog_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="venbhas_blog_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">article_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Venbhas_Blog::article</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="venbhas_blog_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>article_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">article_id</item>
                </item>
            </argument>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected articles?</message>
                        <title translate="true">Delete selected</title>
                    </confirm>
                    <url path="blog/article/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status_draft">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to mark the selected articles as Draft?</message>
                        <title translate="true">Change status</title>
                    </confirm>
                    <url path="blog/article/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>status_draft</type>
                    <label translate="true">Draft</label>
                </settings>
            </action>
            <action name="status_published">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to mark the selected articles as Published?</message>
                        <title translate="true">Change status</title>
                    </confirm>
                    <url path="blog/article/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>status_published</type>
                    <label translate="true">Published</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="venbhas_blog_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>article_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="article_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="title" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="url_key" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">URL Key</label>
            </settings>
        </column>
        <column name="status" sortOrder="40" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Venbhas\Blog\Model\Article\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="created_at" sortOrder="60" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created at</label>
            </settings>
        </column>
        <column name="updated_at" sortOrder="70" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated at</label>
            </settings>
        </column>
        <actionsColumn name="actions" sortOrder="90" class="Venbhas\Blog\Ui\Component\Listing\Column\ArticleActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">90</item>
                </item>
            </argument>
            <settings>
                <indexField>article_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
